#!/usr/bin/env python3
import argparse
import fnmatch
import hashlib
import os
import subprocess
import sys

PATTERNS = ["CLAUDE.md", "AGENTS.md", ".mcp.json", ".claude/*"]
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def store_dir():
    return os.environ.get("FLOWKIT_TRUST_DIR") or os.path.join(ROOT, "trusted")


def protected(repo):
    out = subprocess.run(["git", "-C", repo, "ls-files"], capture_output=True, text=True, check=True).stdout
    files = [f for f in out.splitlines() if any(fnmatch.fnmatch(f, p) for p in PATTERNS)]
    return sorted(files)


def digest(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        h.update(f.read())
    return h.hexdigest()


def manifest(repo):
    return {f: digest(os.path.join(repo, f)) for f in protected(repo)}


def store_path(repo, name):
    return os.path.join(store_dir(), "%s.sha256" % (name or os.path.basename(os.path.abspath(repo))))


def bless(repo, name):
    path = store_path(repo, name)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        for file, h in manifest(repo).items():
            f.write("%s  %s\n" % (h, file))
    print("blessed %d files -> %s" % (len(manifest(repo)), path))
    return 0


def check(repo, name):
    path = store_path(repo, name)
    try:
        with open(path) as f:
            trusted = dict(reversed(line.rstrip("\n").split("  ", 1)) for line in f if line.strip())
    except FileNotFoundError:
        print("UNTRUSTED: no manifest at %s" % path)
        return 2
    current = manifest(repo)
    changed = sorted(f for f in set(trusted) | set(current) if trusted.get(f) != current.get(f))
    if changed:
        print("UNTRUSTED: " + ", ".join(changed))
        return 1
    print("trusted: %d files" % len(current))
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="trust", description="Pin the instruction files agents follow in a repo, and detect changes.")
    ap.add_argument("action", choices=["bless", "check", "list"])
    ap.add_argument("repo")
    ap.add_argument("--name")
    args = ap.parse_args(argv)
    if args.action == "list":
        print("\n".join(protected(args.repo)))
        return 0
    return bless(args.repo, args.name) if args.action == "bless" else check(args.repo, args.name)


if __name__ == "__main__":
    sys.exit(main())
